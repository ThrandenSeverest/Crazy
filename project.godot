config_version=5

[application]

config/name="Crazy: Dark Lord RPG"
run/main_scene="res://scenes/world_map.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")

[autoload]

Game="*res://scripts/game.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[rendering]

# Forward+ is the desktop default. The target RTX 5070 can use its shadows,
# screen-space ambient occlusion and glow; Godot still offers its normal
# compatibility fallback if the game is launched with that renderer.
textures/default_filters/use_nearest_mipmap_filter=false
